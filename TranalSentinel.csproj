<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>TranalSentinel</AssemblyName>
    <RootNamespace>TranalSentinel</RootNamespace>
    <Product>TRANAL SENTINEL</Product>
    <Version>0.17.0</Version>
    <!-- Sempre otimizado: o TRANAL BENCH e os stress tests precisam do JIT otimizado tambem em Debug -->
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- O projeto de testes fica dentro da pasta do app: precisa ficar de fora do glob de compilacao.
         O instalador tambem: e um executavel separado, que publica o app. -->
    <Compile Remove="TranalSentinel.Tests\**" />
    <None Remove="TranalSentinel.Tests\**" />
    <EmbeddedResource Remove="TranalSentinel.Tests\**" />
    <Compile Remove="Tranal.Setup\**" />
    <None Remove="Tranal.Setup\**" />
    <EmbeddedResource Remove="Tranal.Setup\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo-badge.png" />
    <Resource Include="Assets\logo-dark.png" />
  </ItemGroup>

  <!-- Drivers seriais oficiais embutidos (TRANAL MAKER): cada pasta Drivers\<chip> vira recurso e e extraida na hora de instalar.
       Para incluir outro, basta criar a pasta com o .inf/.cat/.sys e liga-la em MakerDrivers.Chips (Bundle). -->
  <ItemGroup>
    <EmbeddedResource Include="Drivers\**\*" Exclude="Drivers\*.md;Drivers\*.txt" LogicalName="Drivers/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- iCUE SDK da Corsair (TRANAL INTEGRACAO): se a DLL estiver em Native\, ela vai junto do .exe. Nao e versionada no git. -->
  <ItemGroup>
    <None Include="Native\iCUESDK.x64_2019.dll" Condition="Exists('Native\iCUESDK.x64_2019.dll')" Link="iCUESDK.x64_2019.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.Dxc" Version="3.8.3" />
  </ItemGroup>

</Project>
