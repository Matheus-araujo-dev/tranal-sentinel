<Window x:Class="TranalSentinel.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRANAL SENTINEL monitor" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border x:Name="Box" Background="#D90A0A0A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,9">
        <StackPanel TextElement.FontFamily="Cascadia Mono, Consolas" TextElement.FontSize="12" TextElement.Foreground="#F5F5F5">
            <StackPanel.LayoutTransform>
                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
            </StackPanel.LayoutTransform>
            <!-- Cabeçalho (só no modo desktop: o overlay não precisa de título) -->
            <Grid x:Name="Cabecalho">
                <TextBlock Text="TRANAL SENTINEL" Foreground="#5A5A5A" FontSize="10" VerticalAlignment="Center"/>
                <Button x:Name="BtnFechar" Content="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="10"
                        Foreground="#8C8C8C" Background="Transparent" BorderThickness="0" Padding="4,0,0,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" Click="BtnFechar_Click"/>
            </Grid>

            <!-- Seção de FPS (visível quando há jogo ou no modo jogo) -->
            <StackPanel x:Name="SecaoFps" Visibility="Collapsed">
                <StackPanel x:Name="OFpsRow" Orientation="Horizontal">
                    <TextBlock x:Name="OFps" Text="—" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="OFpsUnit" Text=" FPS" Foreground="#8C8C8C" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    <TextBlock x:Name="OFrameTime" Text="" Foreground="#8C8C8C" VerticalAlignment="Bottom" Margin="12,0,0,4"/>
                </StackPanel>
                <TextBlock x:Name="OLow" Text="1% low —" Foreground="#8C8C8C"/>
                <Canvas x:Name="OGraph" Width="190" Height="30" Margin="0,6,0,4" ClipToBounds="True"/>
            </StackPanel>

            <!-- Linhas de sensores do overlay (GPU, VRAM, CPU, RAM com itens configuráveis) -->
            <ItemsControl x:Name="ORows" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Foreground="#8C8C8C"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Linhas do painel (CPU, GPU, RAM, ventoinha — fixas, do PainelRegras) -->
            <ItemsControl x:Name="PLinhas" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Rotulo}" Foreground="#8C8C8C"/>
                            <TextBlock Grid.Column="1" Text="{Binding Valor}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Rodapé do overlay (nome do jogo e/ou hora) -->
            <TextBlock x:Name="OGame" Text="" Foreground="#5A5A5A" FontSize="10" Margin="0,5,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>
