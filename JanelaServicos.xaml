<Window x:Class="TranalSentinel.JanelaServicos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suspender serviços"
        Width="720" Height="620"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="SUSPENDER SERVIÇOS" Style="{StaticResource H1}"/>
        <TextBlock Grid.Row="1" Text="Programas em segundo plano que sobem com o Windows e quase não fazem nada. Suspensos, eles param de rodar e voltam a iniciar quando você quiser. Serviço do Windows e serviço de segurança nunca entram na lista."
                   Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,4,0,12"/>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ListaServicos">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,10,12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="Box" IsChecked="{Binding Selecionado, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Programa}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Nome}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Motivo}" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ModoInicializacao}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" x:Name="Status" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnRestaurar" Style="{StaticResource OutlineButton}" Content="RESTAURAR TUDO" Padding="16,8" Margin="0,0,10,0" Click="BtnRestaurar_Click" Visibility="Collapsed"/>
            <Button x:Name="BtnSuspender" Style="{StaticResource PrimaryButton}" Content="SUSPENDER ESCOLHIDOS" Padding="16,8" Click="BtnSuspender_Click"/>
            <Button Style="{StaticResource OutlineButton}" Content="FECHAR" Padding="16,8" Margin="10,0,0,0" Click="BtnFechar_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
