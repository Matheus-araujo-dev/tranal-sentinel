<Project>

  <!--
    Versão e identidade do produto, em UM lugar só.

    O app (TranalSentinel.csproj) e o instalador (Tranal.Setup\Tranal.Setup.csproj)
    têm que concordar: o instalador lê a versão do app para mostrar em
    "Apps e recursos", e o auto-update compara a versão do assembly com a da
    release. Versão repetida em dois csproj é versão que vai divergir.

    Para subir a versão, mude só aqui.
  -->
  <PropertyGroup>
    <Version>0.31.0</Version>
    <AssemblyVersion>0.31.0.0</AssemblyVersion>
    <FileVersion>0.31.0.0</FileVersion>
    <InformationalVersion>0.31.0</InformationalVersion>
    <Product>TRANAL SENTINEL</Product>
    <Company>TRANAL</Company>
  </PropertyGroup>

</Project>
