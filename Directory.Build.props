<Project>

  <!--
    Versão e identidade do produto, em UM lugar só.

    O auto-update compara a versão do assembly com a da release, e o
    instalador (installer	ranal-sentinel.iss) lê a versão do próprio
    TranalSentinel.exe quando não recebe /DMyAppVersion. No CI a versão vem
    da tag (publicar.yml) e este número é só um piso.
  -->
  <PropertyGroup>
    <Version>0.37.0</Version>
    <AssemblyVersion>0.37.0.0</AssemblyVersion>
    <FileVersion>0.37.0.0</FileVersion>
    <InformationalVersion>0.37.0</InformationalVersion>
    <Product>TRANAL SENTINEL</Product>
    <Company>TRANAL</Company>
  </PropertyGroup>

</Project>
